{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-power.github.io/open-knowledge-studio/schemas/recall-case.schema.json",
  "title": "OKS recall evaluation dataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "version", "cases"],
  "properties": {
    "schema_version": {"const": "recall-case/v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "query", "relevant"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "query": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "default": "none"},
          "scope": {"type": ["string", "null"]},
          "type_filter": {"type": ["string", "null"]},
          "relevant": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "forbidden": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true,
            "default": []
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
