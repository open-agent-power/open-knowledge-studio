# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# CLI local data (all .oks state, not just snapshots)
.oks/
cli/.oks/
cli/knowledge_studio.egg-info/

# Trace append locks (runtime state, not trace content)
raw/executions/*/.append.lock

# Qoder local runtime state (scheduled tasks etc.)
.qoder/

# Codex local runtime state
.codex-tmp/
.worktrees/

# Playwright MCP cache (local automation state)
.playwright-mcp/

# Temporary ingest artifacts
.tmp/

# OKS backup files
*.oks-bak

# Bundled assets (build artifact — generated by scripts/bundle_assets.py from repo-root source)
cli/knowledge_studio/_assets/

# Vendored connector (build artifact — setup.py copies scripts/ here so it reaches sdists)
cli/oks_connector/

# setuptools sdist/egg-info leaks copies of scripts/ into cli/scripts/ — only the
# real build helpers belong to the repo.
cli/scripts/*
!cli/scripts/bundle_assets.py
!cli/scripts/check_dist.py
!cli/scripts/smoke_installed.py

# Logs
*.log

# GitHub Pages
docs/_site/
docs/.jekyll-cache/
docs/Gemfile
docs/Gemfile.lock
docs/_config.dev.yml

# Generated document/PDF test artifacts
output/pdf/
tmp/pdfs/

# Wiki content (local only — do not push to remote)
wiki/**/*.md
!wiki/**/.gitkeep

# Raw captures are local evidence, not Studio source code.
raw/**
!raw/articles/
!raw/articles/.gitkeep
!raw/misc/
!raw/misc/.gitkeep
!raw/papers/
!raw/papers/.gitkeep
!raw/repos/
!raw/repos/.gitkeep

# Drafts content (local only — do not push to remote)
drafts/*.md
!drafts/.gitkeep

# Auto-recall hook (installed by `oks hook install`, personal: baked interpreter paths)
.claude/settings.json
.claude/hooks/
.qoder/settings.json
.oks-treesearch-cache/
records/file-edits.jsonl

# Local agent workflow artifacts and recall trace output
.agent/
records/inject.jsonl

# Mail Skill bindings contain machine-local knowledge base paths.
**/skills/oks-mail/binding.json

# v0.6.14: 临时工作流目录（plans/specs 用 Git history/Issue 存，不 track）
internal/
openspec/

# SQLite 运行残留（测试/本地运行产生，不 track）
*.db
*.db.lock
*.db-journal

# PR body 草稿（临时）
pr-body-*.md
