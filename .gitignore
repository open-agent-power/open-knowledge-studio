# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# CLI local data (all .oks state, not just snapshots)
.oks/
cli/.oks/
cli/knowledge_studio.egg-info/

# Trace append locks (runtime state, not trace content)
raw/executions/*/.append.lock

# Qoder local runtime state (scheduled tasks etc.)
.qoder/

# Codex local runtime state
.codex-tmp/

# Embedded external git repos (pulled by install scripts)
.claude/skills/claude-code-vision-skill/

# Bundled assets (build artifact — generated by scripts/bundle_assets.py from repo-root source)
cli/knowledge_studio/_assets/

# Vendored connector (build artifact — setup.py copies scripts/ here so it reaches sdists)
cli/oks_connector/

# setuptools sdist/egg-info leaks copies of scripts/ into cli/scripts/ — only the
# real build helper belongs to the repo.
cli/scripts/*
!cli/scripts/bundle_assets.py

# Logs
*.log

# GitHub Pages
docs/_site/
docs/.jekyll-cache/
docs/Gemfile
docs/Gemfile.lock
docs/_config.dev.yml

# Generated document/PDF test artifacts
output/pdf/
tmp/pdfs/

# Temporary run artifacts — acceptance scripts, experiments, scratch
tmp/
experiments/
home=D#/

# Wiki content (local only — do not push to remote)
wiki/**/*.md
!wiki/**/.gitkeep

# Raw captures are local evidence, not Studio source code.
raw/**
!raw/articles/
!raw/articles/.gitkeep
!raw/misc/
!raw/misc/.gitkeep
!raw/papers/
!raw/papers/.gitkeep
!raw/repos/
!raw/repos/.gitkeep

# Drafts content (local only — do not push to remote)
drafts/*.md
!drafts/.gitkeep

# Old profiles (local only, not published to remote)
profiles/projects/agentuniverse.md
profiles/projects/apache-project-contribution.md
profiles/projects/current-microservice-migration.md
profiles/projects/current-paper-project.md
profiles/projects/current-ui-refactor.md
profiles/projects/higress.md
profiles/projects/oss-compass.md
profiles/projects/rocketmq.md
profiles/users/mrjlv1/
.playwright-mcp/
