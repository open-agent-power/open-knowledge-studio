{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-studio.local/schemas/raw-bundle-v0.2.json",
  "title": "OKS Raw Bundle Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "capture_id",
    "content_hash",
    "recipe_version",
    "processing_status",
    "files",
    "sources",
    "provenance",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "raw-multimodal/v0.2"},
    "bundle_id": {"type": "string", "minLength": 1},
    "capture_id": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recipe_version": {"type": "string", "minLength": 1},
    "processing_status": {"enum": ["complete", "partial", "failed"]},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "content", "evidence", "quality_report", "processing_runs", "source_dir", "assets_dir", "derived_dir"],
      "properties": {
        "manifest": {"const": "bundle.json"},
        "content": {"const": "content.md"},
        "evidence": {"const": "evidence.jsonl"},
        "quality_report": {"const": "quality-report.json"},
        "processing_runs": {"const": "processing-runs.jsonl"},
        "source_dir": {"const": "source/"},
        "assets_dir": {"const": "assets/"},
        "derived_dir": {"const": "derived/"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "path", "sha256", "primary_source"],
        "properties": {
          "entity_id": {"type": "string"},
          "path": {"type": "string", "pattern": "^source/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": ["string", "null"]},
          "snapshot_kind": {"enum": ["content", "reference"]},
          "content_hash_status": {"enum": ["verified", "unavailable"]},
          "primary_source": {"type": "boolean"}
        }
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "kind", "path", "generated_by", "derived_from", "review_status"],
        "properties": {
          "entity_id": {"type": "string"},
          "kind": {"enum": ["ocr", "asr", "visual_observation", "layout", "other"]},
          "path": {"type": "string", "pattern": "^derived/"},
          "generated_by": {"type": "string"},
          "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "review_status": {"enum": ["not_applicable", "unreviewed", "reviewed"]},
          "model": {"type": ["string", "null"]},
          "cost": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "activities", "agents", "relations"],
      "properties": {
        "entities": {"type": "array", "items": {"type": "object"}},
        "activities": {"type": "array", "items": {"type": "object"}},
        "agents": {"type": "array", "items": {"type": "object"}},
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "subject", "object"],
            "properties": {
              "type": {"enum": ["used", "wasGeneratedBy", "wasDerivedFrom"]},
              "subject": {"type": "string"},
              "object": {"type": "string"}
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
