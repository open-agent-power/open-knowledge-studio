{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-studio.local/schemas/evidence-manifest-v0.1.json",
  "title": "OKS Evidence Manifest v0.1",
  "description": "The final evidence declaration that an Agent submits to oks raw commit. The Agent collects one or more EvidenceFragments from individual tools, judges overall completeness, merges them, and produces this Manifest. It is submitted alongside a SourceEnvelope and the referenced artifact files. OKS core validates structural integrity, cross-references, artifact existence, hash matching, and locator legality — then assembles a Raw Bundle v0.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "source_id",
    "status",
    "fragment_refs",
    "primary_artifact",
    "evidence_records",
    "modalities",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "oks-evidence-manifest/v0.1"},
    "manifest_id": {
      "description": "Stable identifier for this manifest, generated by the Agent.",
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "description": "Must match SourceEnvelope.source_id.",
      "type": "string",
      "minLength": 1
    },
    "status": {
      "description": "Agent's judgment of overall evidence completeness. 'complete' means evidence is sufficient to proceed to Candidate. 'partial' means the Agent has done its best but evidence is incomplete. There is no 'failed' status — if all fragments fail, the Agent should not submit a Manifest.",
      "enum": ["complete", "partial"]
    },
    "fragment_refs": {
      "description": "List of EvidenceFragment fragment_ids that were merged into this manifest. Preserves the full provenance chain.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "primary_artifact": {
      "description": "The main evidence artifact (typically the primary text content).",
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["primary_text", "page_image", "ocr_result", "subtitle", "screenshot", "dom_snapshot", "api_response", "rendered_page", "other"]
        },
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locator_kind": {"enum": ["page", "bbox", "timestamp", "dom", "document", "custom"]}
      }
    },
    "supplementary_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["primary_text", "page_image", "ocr_result", "subtitle", "screenshot", "dom_snapshot", "api_response", "rendered_page", "other"]},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": ["string", "null"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "locator_kind": {"enum": ["page", "bbox", "timestamp", "dom", "document", "custom"]}
        }
      }
    },
    "evidence_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "artifact_id", "kind", "method", "locator"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "locator": {
            "$ref": "https://open-knowledge-studio.local/schemas/locator-v0.1.json",
            "description": "Formal evidence locator. Must conform to OKS Locator Schema v0.1."
          },
          "text": {"type": ["string", "null"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "agent_judgment": {"enum": ["mechanical", "agent_observed", "human_supplied"]}
        }
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modality", "status", "evidence_count"],
        "properties": {
          "modality": {"enum": ["text", "image", "layout", "speech", "video"]},
          "status": {"enum": ["succeeded", "partial", "failed", "skipped"]},
          "evidence_count": {"type": "integer", "minimum": 0},
          "error_code": {"type": ["string", "null"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "failure_disposition": {
      "description": "When status is 'partial', explains why. Values: none, needs_user_auth, needs_user_action, retryable, final.",
      "type": "string",
      "enum": ["none", "needs_user_auth", "needs_user_action", "retryable", "final"]
    },
    "agent_observation_ref": {
      "description": "Optional reference to an AgentObservation that accompanies this manifest.",
      "type": ["string", "null"]
    },
    "steps": {
      "description": "Execution trace recording every Provider attempt and outcome, including degradation decisions.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider", "status"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "status": {"enum": ["succeeded", "partial", "degraded", "failed", "skipped"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "notes": {
      "description": "Optional metadata about the evidence collection: counts, hashes, format flags.",
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime"],
          "properties": {
            "runtime": {"type": "string", "minLength": 1},
            "model": {"type": ["string", "null"]},
            "skill": {"type": ["string", "null"]}
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "cost": {
                "type": ["object", "null"],
                "properties": {
                  "amount": {"type": "number"},
                  "unit": {"type": "string"},
                  "currency": {"type": ["string", "null"]}
                }
              }
            }
          }
        },
        "latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "partial"}}},
      "then": {
        "properties": {
          "failure_disposition": {
            "enum": ["needs_user_auth", "needs_user_action", "retryable", "final"]
          },
          "warnings": {"minItems": 1}
        }
      }
    }
  ]
}
