{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-studio.local/schemas/evidence-fragment-v0.1.json",
  "title": "OKS Evidence Fragment v0.1",
  "description": "A single tool's contribution to evidence acquisition. Each external capability (Firecrawl, AgentKey, pdf-lite, Agent vision) produces one EvidenceFragment. The Agent collects multiple fragments and merges them into a single EvidenceManifest before calling oks raw commit. Fragment status is three-valued: succeeded, partial, failed — the Agent judges overall completeness when merging.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fragment_id",
    "source_id",
    "producer",
    "status",
    "artifacts",
    "evidence",
    "modalities"
  ],
  "properties": {
    "schema_version": {"const": "oks-evidence-fragment/v0.1"},
    "fragment_id": {
      "description": "Stable identifier for this fragment, generated by the producer or Agent.",
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "description": "References the SourceEnvelope.source_id this fragment belongs to.",
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "description": "Who produced this fragment — runtime, registered provider, and tool.  'provider' is the Registered Provider ID (from provider.yaml), 'agent-runtime' for Agent-native observation, or 'runtime-tool' for ad-hoc tools (curl, playwright, etc.).  'tool' is the specific tool name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tool"],
      "properties": {
        "runtime": {
          "description": "Runtime environment that orchestrated the producer.",
          "type": "string"
        },
        "provider": {
          "description": "Registered Provider ID (from provider.yaml) or 'agent-runtime' or 'runtime-tool'.",
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "description": "Specific tool name — provider ID for registered providers, actual tool name for runtime-tool (e.g. 'curl', 'playwright'), 'agent-runtime' for Agent-native.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "producer_version": {
      "description": "Version of the producer tool, if known.",
      "type": ["string", "null"]
    },
    "status": {
      "description": "Outcome of this single tool's capture attempt. The Agent judges overall completeness when merging fragments into the EvidenceManifest.",
      "enum": ["succeeded", "partial", "failed"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "primary_text", "page_image", "ocr_result", "subtitle",
              "screenshot", "dom_snapshot", "api_response",
              "rendered_page", "other"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "media_type": {"type": ["string", "null"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "locator_kind": {
            "enum": ["page", "bbox", "timestamp", "dom", "document", "custom"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "artifact_id", "kind", "method", "locator"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "locator": {
            "$ref": "https://open-knowledge-studio.local/schemas/locator-v0.1.json",
            "description": "Formal evidence locator. Must conform to OKS Locator Schema v0.1."
          },
          "text": {"type": ["string", "null"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "agent_judgment": {
            "enum": ["mechanical", "agent_observed", "human_supplied"]
          }
        }
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modality", "status", "evidence_count"],
        "properties": {
          "modality": {
            "enum": ["text", "image", "layout", "speech", "video"]
          },
          "status": {
            "enum": ["succeeded", "partial", "failed", "skipped"]
          },
          "evidence_count": {"type": "integer", "minimum": 0},
          "error_code": {"type": ["string", "null"]}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cost": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "unit": {"type": "string"},
        "currency": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string"},
        "tool_version": {"type": ["string", "null"]},
        "endpoint": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"properties": {"evidence": {"maxItems": 0}}}
    }
  ]
}
