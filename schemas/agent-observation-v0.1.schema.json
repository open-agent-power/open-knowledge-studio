{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-studio.local/schemas/agent-observation-v0.1.json",
  "title": "OKS Agent Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_capture_id",
    "status",
    "agent",
    "claims",
    "warnings",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "oks-agent-observation/v0.1"},
    "observation_id": {"type": "string", "minLength": 1},
    "source_capture_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["full", "partial", "failed"]},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "model"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "skill": {"type": ["string", "null"]}
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "status", "evidence_refs"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "uncertain", "not_observed"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "locator"],
              "properties": {
                "artifact_id": {"type": "string", "minLength": 1},
                "locator": {"type": "object", "minProperties": 1}
              }
            }
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "partial"}}},
      "then": {"properties": {"warnings": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"properties": {"claims": {"maxItems": 0}}}
    }
  ]
}
