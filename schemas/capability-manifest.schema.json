{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-knowledge-studio.local/schemas/capability-manifest-v0.1.json",
  "title": "OKS Capability Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "version",
    "accepts",
    "command",
    "required_environment",
    "produces",
    "license",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "oks-capability-manifest/v0.1"},
    "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "version": {"type": "string", "minLength": 1},
    "accepts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime_types", "extensions"],
      "properties": {
        "mime_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "extensions": {"type": "array", "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}, "uniqueItems": true},
        "source_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "required"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["executable", "python", "package", "model", "service", "environment_variable"]},
          "required": {"type": "boolean"},
          "probe": {"type": ["array", "null"], "items": {"type": "string"}}
        }
      }
    },
    "produces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "schema": {"type": ["string", "null"]}
        }
      }
    },
    "license": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "network_policy": {"enum": ["offline", "public_http", "platform_api", "user_authenticated_browser"]}
  }
}
